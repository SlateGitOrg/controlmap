# controlmap reads configuration from controlmap.yaml; these variables are optional.

# GitHub API mode only: the name of this variable is set by `api.token_env` in the config.
# Use a fine-grained token with read access to repository administration and contents.
GITHUB_TOKEN=

# Override the GitHub API base URL (e.g. the offline mock: http://127.0.0.1:8765).
GITHUB_API_URL=

# Fixed "now" for reproducible packages (seconds since the Unix epoch).
SOURCE_DATE_EPOCH=
