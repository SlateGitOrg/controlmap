<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ company }} evidence package</title><style>{{ css }}</style></head>
<body><main>
<h1>{{ company }} &mdash; SOC 2 evidence package</h1>
<p class="meta">Evidence as of {{ as_of }} &middot; generated {{ generated_at }} &middot; controlmap {{ tool_version }}</p>
<div class="notice">{{ disclaimer }}</div>
<div class="tiles">{% for status, n in counts.items() %}<div class="tile"><b>{{ n }}</b><span class="badge s-{{ status }}">{{ status }}</span></div>{% endfor %}</div>
<h2>Controls</h2>
<div class="wrap"><table><tr><th>Control</th><th>Title</th><th>Owner</th><th>TSC</th><th>Status</th></tr>
{% for c in controls %}<tr><td><a href="controls/{{ c.control_id }}.html">{{ c.control_id }}</a></td><td>{{ c.title }}</td><td>{{ c.owner }}</td>
<td>{{ c.tsc_ids | join(", ") }}</td><td><span class="badge s-{{ c.status }}">{{ c.status }}</span></td></tr>
{% endfor %}</table></div>
<h2>Trust Services Criteria coverage</h2>
<p class="meta">{{ coverage.tsc_covered }} of {{ coverage.tsc_in_scope }} in-scope criteria have at least one automated control. Criteria without one need manual testing.</p>
<div class="wrap"><table><tr><th>Criterion</th><th>Topic (paraphrased)</th><th>Controls</th><th>ISO 27001:2022</th><th>Status</th></tr>
{% for row in criteria %}<tr><td>{{ row.id }}</td><td>{{ row.label }}</td><td>{{ row.controls | join(", ") or "—" }}</td>
<td>{{ row.iso27001 | join(", ") or "—" }}</td><td><span class="badge s-{{ row.status or 'GAP' }}">{{ row.status or "NO CONTROL" }}</span></td></tr>
{% endfor %}</table></div>
<h2>Exceptions</h2>
{% if exceptions %}<div class="wrap"><table><tr><th>Id</th><th>Control</th><th>State</th><th>Expires</th><th>Flags</th></tr>
{% for e in exceptions %}<tr><td>{{ e.id }}</td><td>{{ e.control }}</td><td>{{ e.state }}</td><td>{{ e.expires_on }}</td><td>{{ e.flags | join(", ") or "—" }}</td></tr>
{% endfor %}</table></div>{% else %}<p>No exceptions registered.</p>{% endif %}
<h2>Verifying this package</h2>
<p>Every file is listed with its SHA-256 in <code>manifest.json</code> and <code>MANIFEST.sha256</code>. Run <code>controlmap verify &lt;dir&gt;</code>, or <code>shasum -a 256 -c MANIFEST.sha256</code> from inside the directory.{% if signed %} The manifest is signed (Ed25519, key fingerprint <code>{{ fingerprint }}</code>); confirm that fingerprint with the sender through a separate channel.{% endif %}</p>
</main></body></html>
